{
	"root": true,
	"project": {
		"name": "INUT"
	},
	"api": {
		"projectId": "soud11bs",
		"dataset": "production"
	},
	"plugins": [
		"@sanity/base",
		"@sanity/default-layout",
		"@sanity/default-login",
		"@sanity/desk-tool",
		"media"
	],
	"env": {
		"development": {
			"plugins": ["@sanity/vision"]
		}
	},
	"parts": [
		{
			"name": "part:@sanity/base/schema",
			"path": "./schemas/schema"
		},
		{
			"implements": "part:@sanity/base/document-actions/resolver",
			"path": "./schemas/creativa/actions.js"
		},
		{
			"implements": "part:@sanity/base/new-document-structure",
			"path": "./schemas/creativa/new-documents.js"
		},
		{
			"implements": "part:@sanity/desk-tool/structure",
			"path": "./schemas/creativa/desk.js"
		}
	]
}
