  "repository": {
    "type": "git",
    "url": "https://github.com/tinspham209/inut-design.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migration/validate-env.mjs --stage=build && next build",
    "build:analyze": "ANALYZE=true pnpm build",
    "start": "next start",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx pages components api-client server hooks lib scripts utils next.config.js",
    "export": "next export",
    "postbuild": "next-sitemap --config next-sitemap.config.js && node scripts/verify-seo.mjs",
    "sanity": "cd ./sanity && pnpm start",
    "regression": "./scripts/regression-test.sh",
    "regression:lighter": "./scripts/test-lighter-builder.sh",
    "regression:spx": "node --import ./scripts/register-typescript-loader.mjs ./scripts/test-spx-sync.mjs",
    "regression:creativa-notification": "node --import ./scripts/register-typescript-loader.mjs ./scripts/test-creativa-notification-format.mjs",
    "regression:quote-form": "./scripts/regression-test-quote-form.sh",
    "migration:inventory": "node scripts/migration/inventory-dependencies.mjs && node scripts/migration/inventory-env.mjs && node scripts/migration/inventory-call-sites.mjs && node scripts/migration/slug-manifest.mjs",
    "migration:verify-routes": "node scripts/migration/verify-route-manifest.mjs",
    "migration:verify-apis": "node scripts/migration/verify-api-manifest.mjs",
    "migration:check-manifests": "node scripts/migration/check-manifests.mjs",
    "migration:check-secrets": "node scripts/migration/check-secrets.mjs",
    "migration:check-worker-graph": "node scripts/migration/check-worker-graph.mjs",
    "regression:safe": "node scripts/migration/run-safe-regression.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "node scripts/migration/validate-env.mjs --stage=build && vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
