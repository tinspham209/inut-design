# Copy to .dev.vars and fill values locally. Never commit .dev.vars.

# Public/non-secret runtime config
# Umami's NEXT_PUBLIC_* values are build-time inputs from .env/.env.local;
# entries here alone do not configure the browser bundle. Keep them in sync.
NEXT_PUBLIC_ENABLE_UMAMI=true
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_HOST_URL=https://cloud.umami.is
DEPLOYMENT_CHANNEL=preview
PREVIEW_SITE_URL=https://your-preview-hostname.workers.dev
SANITY_PROJECT_ID=
SANITY_DATASET=

# Server-only Sanity
SANITY_TOKEN=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CREATIVA_TELEGRAM_BOT_TOKEN=
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_BASE_DELAY=1000

# SPX scheduler
SPX_SYNC_SECRET=
SPX_SYNC_TELEGRAM_BOT_TOKEN=
SPX_SYNC_TELEGRAM_CHAT_ID=
SPX_SYNC_FUNCTION_TIMEOUT_MS=30000

NEXT_PUBLIC_SITE_URL=https://inutdesign.com
